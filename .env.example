# =====================================================================
# support-triage-ai environment template
# Copy to .env and fill in values:  cp .env.example .env
# Never commit .env. Never put real keys in this file.
# Comments sit on their own line (inline comments are not portable
# across Node's env loader and docker compose).
# =====================================================================

# --- App ---
# Runtime mode: development | test | production
NODE_ENV=development
# Service name used in logs and traces
APP_NAME=support-triage-ai
# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Port for the Hono API (apps/api)
API_PORT=3001
# Port for the Next.js web app (apps/web)
WEB_PORT=3000
# Base URL the web app uses to call the API (keep the port in sync with API_PORT)
API_URL=http://localhost:3001

# --- Database (Postgres + pgvector) ---
# App connection string: a host-installed PostgreSQL with pgvector, or the Docker one
# (pnpm infra:up:postgres-local). e.g. postgresql://<user>:<password>@localhost:5432/<db>
# POSTGRES_USER/PASSWORD/DB/PORT below are only used by the Docker profile.
DATABASE_URL=
# Postgres superuser created by docker compose
POSTGRES_USER=
# Password for POSTGRES_USER (generate a random one)
POSTGRES_PASSWORD=
# Database name created by docker compose
POSTGRES_DB=
# Host port mapped to the Postgres container
POSTGRES_PORT=5432

# --- LLM providers ---
# Chat provider: anthropic (Claude, paid) | groq (open models, free tier) | openai | ollama
LLM_PROVIDER=groq
# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Groq API key from console.groq.com (required when LLM_PROVIDER=groq)
GROQ_API_KEY=
# Groq's OpenAI-compatible API base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenAI API key (required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
# Base URL of a local Ollama server (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Model names belong to the chosen LLM_PROVIDER.
#   groq:      openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.8-27b (check: GET /models)
#   anthropic: claude-sonnet-5-5 | claude-haiku-5-5 | claude-opus-5-5
# Main model for chat and triage answers
MODEL_CHAT=openai/gpt-oss-120b
# Cheaper/faster model for classification and routing
MODEL_CHEAP=openai/gpt-oss-20b
# Model used as LLM-as-judge in evals
MODEL_JUDGE=qwen/qwen3.8-27b
# Who makes embeddings: voyage (free tokens) | openai | ollama (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=voyage
# Voyage AI API key from dashboard.voyageai.com (required when EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=
# Voyage AI API base URL
VOYAGE_BASE_URL=https://api.voyageai.com/v1
# Embedding model: voyage-4 (voyage) or text-embedding-3-small (openai)
MODEL_EMBEDDING=voyage-4
# Vector size produced by MODEL_EMBEDDING. Must match the pgvector column (a migration).
# voyage-4: 1024 (also 256/512/2048) · text-embedding-3-small: 1536
EMBEDDING_DIMENSIONS=1024
# Sampling temperature (0 = deterministic). Current Claude models reject it, so it is only
# sent to groq/openai/ollama chat models.
LLM_TEMPERATURE=0.2
# Claude effort per answer: low | medium | high | xhigh | max (more effort = deeper, slower, pricier)
LLM_EFFORT=medium
# Claude refusal fallback: default (API retries a safety-declined request on a fallback model) | off
LLM_REFUSAL_FALLBACK=default
# Max tokens the model may generate per call, INCLUDING thinking tokens (too low = cut-off answers)
LLM_MAX_OUTPUT_TOKENS=4096
# Per-call timeout in milliseconds
LLM_TIMEOUT_MS=30000
# Retries on transient provider errors
LLM_MAX_RETRIES=2

# --- RAG ---
# Target chunk size in characters
RAG_CHUNK_SIZE=800
# Overlap between consecutive chunks in characters
RAG_CHUNK_OVERLAP=100
# Number of chunks fetched by vector search
RAG_TOP_K=8
# Number of chunks kept after reranking
RAG_RERANK_TOP_N=4
# Max cosine distance for a chunk to count as relevant (0 = identical, 1 = unrelated). Above it,
# the assistant answers "not found" without calling the LLM. Measured: relevant 0.32-0.53, off-topic 0.76+
RAG_MAX_DISTANCE=0.70
# Reranker: none | cohere | local
RAG_RERANKER=none
# Cohere API key (required when RAG_RERANKER=cohere)
COHERE_API_KEY=
# Folder with help-centre articles (.md/.txt) to ingest, relative to the project root
KNOWLEDGE_BASE_DIR=data/knowledge-base

# --- Agent and approvals ---
# Max tool-calling steps per agent run
AGENT_MAX_STEPS=6
# If true, every side-effecting tool call waits for human approval
AGENT_REQUIRE_APPROVAL=true
# Pending approvals expire after this many minutes
APPROVAL_TIMEOUT_MINUTES=30

# --- Guardrails and privacy ---
# Redact PII before text is sent to a model or logged
PII_REDACTION_ENABLED=true
# Screen user input and retrieved docs for prompt injection
PROMPT_INJECTION_CHECK_ENABLED=true
# Write an audit record for every agent action and approval
AUDIT_LOG_ENABLED=true

# --- Observability (Langfuse + OpenTelemetry) ---
# Langfuse project public key (from the Langfuse UI)
LANGFUSE_PUBLIC_KEY=
# Langfuse project secret key (from the Langfuse UI)
LANGFUSE_SECRET_KEY=
# Langfuse base URL: Langfuse Cloud EU (default) https://cloud.langfuse.com,
# Cloud US https://us.cloud.langfuse.com, or self-hosted http://localhost:3002 (langfuse-local profile)
LANGFUSE_HOST=https://cloud.langfuse.com
# OTLP collector endpoint, e.g. a SigNoz or OTel collector URL (empty = disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name reported in traces
OTEL_SERVICE_NAME=support-triage-ai

# --- Cost and rate limits ---
# Hard daily spend cap for LLM calls, in USD
DAILY_BUDGET_USD=5
# Max API requests per client per minute
RATE_LIMIT_PER_MINUTE=60

# --- Integrations (later tasks) ---
# Base URL of the external ticketing system API
TICKETING_API_URL=
# API key for the ticketing system
TICKETING_API_KEY=
# OIDC issuer URL for SSO login
OIDC_ISSUER_URL=
# OIDC client ID registered for this app
OIDC_CLIENT_ID=
# OIDC client secret registered for this app
OIDC_CLIENT_SECRET=

# --- Feature flags ---
# Enable the approval-gated agent
FEATURE_AGENT_ENABLED=false
# Enable retrieval-augmented answers
FEATURE_RAG_ENABLED=true

# --- Self-hosted Langfuse stack (optional `langfuse-local` compose profile; not read by app code) ---
# Only needed if you run Langfuse locally instead of Langfuse Cloud.
# Host port for the Langfuse web UI (keep in sync with LANGFUSE_HOST)
LANGFUSE_PORT=3002
# Langfuse's own Postgres user
LANGFUSE_POSTGRES_USER=
# Langfuse's own Postgres password (generate a random one)
LANGFUSE_POSTGRES_PASSWORD=
# Langfuse's own Postgres database name
LANGFUSE_POSTGRES_DB=
# NextAuth secret for the Langfuse UI (generate: openssl rand -base64 32)
LANGFUSE_NEXTAUTH_SECRET=
# Hashing salt for Langfuse API keys (generate: openssl rand -base64 32)
LANGFUSE_SALT=
# 64-char hex key for encrypting data at rest (generate: openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=
# ClickHouse user for Langfuse analytics storage
CLICKHOUSE_USER=
# ClickHouse password (generate a random one)
CLICKHOUSE_PASSWORD=
# Redis password used by Langfuse queues (generate a random one)
REDIS_PASSWORD=

# --- Object storage (MinIO, S3-compatible) ---
# MinIO admin user (used only by docker compose and the init container, never by app code)
MINIO_ROOT_USER=
# MinIO admin password, at least 8 chars (generate: openssl rand -hex 24)
MINIO_ROOT_PASSWORD=
# Host port for the S3 API
MINIO_API_PORT=9000
# Host port for the MinIO web console
MINIO_CONSOLE_PORT=9001
# S3 API URL as seen from the host (keep the port in sync with MINIO_API_PORT)
MINIO_ENDPOINT=http://localhost:9000
# Web console URL (keep the port in sync with MINIO_CONSOLE_PORT)
MINIO_CONSOLE_URL=http://localhost:9001
# S3 region name reported by MinIO
MINIO_REGION=us-east-1
# Private bucket for Langfuse event uploads
MINIO_LANGFUSE_BUCKET=langfuse
# Bucket with anonymous read access by direct URL (no listing), for public files only
MINIO_PUBLIC_BUCKET=public
# Name of the read/write policy granted to the app user (both buckets)
MINIO_APP_POLICY=sta-app-rw
# App user access key (the app and Langfuse use this, not the root account)
MINIO_APP_ACCESS_KEY=
# App user secret key, at least 8 chars (generate: openssl rand -hex 24)
MINIO_APP_SECRET_KEY=
