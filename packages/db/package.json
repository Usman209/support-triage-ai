{
  "name": "@sta/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:smoke": "tsx scripts/smoke.ts",
    "db:agent-smoke": "tsx scripts/agent-smoke.ts",
    "seed:tickets": "tsx scripts/seed-tickets.ts",
    "seed:tickets:sample": "tsx scripts/seed-tickets.ts --file data/sample/customer_support_tickets.sample.csv",
    "seed:tickets:check": "tsx scripts/seed-check.ts"
  },
  "dependencies": {
    "@sta/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0"
  }
}
